function u64 Standalone.getModdedSoundKey(u64 soundKey, u8 sfxId, u8 soundRegType)
{
		if (sfxId == 0x28) && (global.game_mode == 0x2C)
		{
		if	(nowei == 0x01)
			{
				return "IT"
			}
		else if	(nowei == 0x02)
			{
			return "SMB"
			}
}
//aqui van temas para el nowei
      return base.Standalone.getModdedSoundKey(soundKey, sfxId, soundRegType)
}

function u64 Standalone.getModdedSoundKey(u64 soundKey, u8 sfxId, u8 soundRegType)
{
	if (bluespheres.minigame_mode)
	{
		if (sfxId == 0xf8 || sfxId == 0x1c)
		{
		if (sfera == 0x01)
		{
		return "No45"
		}
		else if (sfera == 0x02)
		{
		return "Noclip45"
		}
		else if (sfera == 0x03)
		{
		return "Space45"
		}
		}
	}
// aqui van temas para el blue spheres random
return base.Standalone.getModdedSoundKey(soundKey, sfxId, soundRegType)
}	

