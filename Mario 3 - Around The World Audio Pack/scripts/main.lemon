function u64 Standalone.getModdedSoundKey(u64 soundKey, u8 sfxId, u8 soundRegType)
{
		if (sfxId == 0x0D) && (laun == 0x01)
            return "arcaend"
		if (sfxId == 0x0D) && (laun == 0x02)
            return "uizar"
		if (sfxId == 0x0D) && (laun == 0x03)
            return "Noid"
		if (sfxId == 0x0D) && (laun == 0x04)
            return "Space"
		if (sfxId == 0x0D) && (laun == 0x05)
            return "Nonamed"	
		if (sfxId == 0x0D) && (laun == 0x06)
            return "Noclip"	
		if (sfxId == 0x0D) && (laun == 0x07)
            return "Nait"
//aqui van temas para LBZ act 1
      return base.Standalone.getModdedSoundKey(soundKey, sfxId, soundRegType)
}

function u64 Standalone.getModdedSoundKey(u64 soundKey, u8 sfxId, u8 soundRegType)
{
		if (sfxId == 0x0E) && (laun2 == 0x02)
            return "arcaend"
		if (sfxId == 0x0E) && (laun2 == 0x03)
            return "uizar"
		if (sfxId == 0x0E) && (laun2 == 0x04)
            return "Space"	
		if (sfxId == 0x0E) && (laun2 == 0x05)
            return "Nonamed"	
		if (sfxId == 0x0E) && (laun2 == 0x06)
            return "Noclip"	
		if (sfxId == 0x0E) && (laun2 == 0x07)
            return "Nait"	
//aqui van temas para LBZ act 2
      return base.Standalone.getModdedSoundKey(soundKey, sfxId, soundRegType)
}

function u64 Standalone.getModdedSoundKey(u64 soundKey, u8 sfxId, u8 soundRegType)
{

		if (sfxId == 0x0E) && (laun2 == 0x01)
		{
           if (laun == 0x01)
		{
            return "arcaend"
		}
		else if (laun == 0x02)
		{
            return "uizar"
		}
		else if (laun == 0x04)
		{
            return "Space"
		}			
		else if (laun == 0x06)
		{
            return "Nonamed"
		}		
		else if (laun == 0x07)
		{
            return "Noclip"	
		}	
		else if (laun == 0x08)
		{
            return "Nait"
		}	
		}
//aqui va el codigo para la opcion de repetir tema del acto 1 para el acto 2
      return base.Standalone.getModdedSoundKey(soundKey, sfxId, soundRegType)
}

function u64 Standalone.getModdedSoundKey(u64 soundKey, u8 sfxId, u8 soundRegType)
{
		if (sfxId == 0x2B)
		{
		if (emeral == 0x01)
		{
            return "IDK11"
		}
		}
//aqui van temas al recoger la esmeralda
      return base.Standalone.getModdedSoundKey(soundKey, sfxId, soundRegType)
}