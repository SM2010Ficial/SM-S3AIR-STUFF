function u64 Standalone.getModdedSoundKey(u64 soundKey, u8 sfxId, u8 soundRegType)
{
	if (sfxId == 0xDC) && (fin == 0x01)
            return "uwolE"
	if (sfxId == 0xDC) && (fin == 0x02)
           return "Nait"
	if (sfxId == 0xDC) && (fin == 0x03)
            return "Rompenait"
	if (sfxId == 0xDC) && (fin == 0x04)
			return "arcaend"
	if (sfxId == 0xDC) && (fin == 0x05)
            return "Year"
	if (sfxId == 0xDC) && (fin == 0x06)
            return "Forest"		
	if (sfxId == 0xDC) && (fin == 0x07)
            return "class"		
//aqui van mas temas del final
      return base.Standalone.getModdedSoundKey(soundKey, sfxId, soundRegType)
}

function u64 Standalone.getModdedSoundKey(u64 soundKey, u8 sfxId, u8 soundRegType)
{
		if (sfxId == 0x1E) && (bolas == 0x01)
            return "Forget"
		if (sfxId == 0x1E) && (bolas == 0x02)
            return "Quick"
		if (sfxId == 0x1E) && (bolas == 0x03)
            return "Lame"
		if (sfxId == 0x1E) && (bolas == 0x04)
            return "Noclip"
//aqui van temas para la maquina de bolas
      return base.Standalone.getModdedSoundKey(soundKey, sfxId, soundRegType)
}

function u64 Standalone.getModdedSoundKey(u64 soundKey, u8 sfxId, u8 soundRegType)
